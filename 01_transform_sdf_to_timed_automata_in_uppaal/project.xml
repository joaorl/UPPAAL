// Global Clock
clock global ;
const int N = 4; //# of Processors
const int M = 3 ; //# of Actors

// Task and Processors IDs
typedef int [0 ,N -1] id_r ;

// Channels
chan end [ N ][ M ] , fire [ N ][ M ];

// Buffer and Edge Sizes
int buff_u2v , buff_v2w =0;
int buff_v2u =2;
int buff_w2v =6;
int buff_v2v =1;

// Flag to check if SDFG has started
bool flag_act = false;

// Counter for each actor
int counter_u , counter_v , counter_w =0;

// Costs (WCET) of each actor
const int cost_u = 20;
const int cost_v = 20;
const int cost_w = 30;

// Arbitrary deadlines of each actor
const int deadline_u = 5;
const int deadline_v = 7;
const int deadline_w = 6;

// Deadline tracking clocks
clock du, dv, dw;

// Processor load tracking
int load[N] = {0,0,0,0};
const int load_limit[N] = {80, 80, 80, 100}; // capacity limits for each processor

void produce ( int &amp; channel_tokens , int tokens )
{
    channel_tokens += tokens ;
}

void consume ( int &amp; channel_tokens , int tokens )
{
    channel_tokens -= tokens ;
}


