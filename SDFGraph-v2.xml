	<system>
// Actor ids
const int u =0;
const int v =1;
const int w =2;
const int dummy =3;

// Processor ids
const int p0 =0;
const int p1 =1;
const int p2 =2;
const int p3 =3;

// SDF Graph template instantiation
SDF_Graph = SDFG (u ,v , w) ;

// Processor template instantiation
Processor0 = Processor ( p0 ,u ,v , w) ;
Processor1 = Processor ( p1 ,u ,v , w) ;
Processor2 = Processor ( p2 ,u ,v , w) ;
Processor3 = Processor ( p3 ,u ,v , w) ;

Processor0_0 = Processor ( p0 ,u , dummy , dummy ) ;
Processor1_0 = Processor ( p1 ,u , dummy , dummy ) ;
Processor2_0 = Processor ( p2 , dummy ,v , dummy ) ;
Processor3_0 = Processor ( p3 , dummy , dummy , w ) ;


// Processes to be composed into a system .
system SDF_Graph , Processor0 , Processor1 , Processor2;// , Processor3 ;</system>
